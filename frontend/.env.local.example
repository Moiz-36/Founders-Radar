NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (no NEXT_PUBLIC_ prefix — never exposed to the browser). Base URL of the
# Python pipeline's FastAPI app (`./.venv/Scripts/uvicorn backend.main:app --reload`, see
# README.md). Used by the app/api/* routes (run, discover, chat, PDF download).
PIPELINE_API_BASE_URL=http://localhost:8000

# Optional locally (unset = no header sent, matches the backend's own no-op-when-unset
# behavior). Required against the deployed public Cloud Run API service — must match the
# backend's PIPELINE_SHARED_SECRET (.env.example) exactly.
PIPELINE_SHARED_SECRET=
