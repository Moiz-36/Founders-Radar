DATABASE_URL=            # Supabase Postgres connection string — use the "postgresql+psycopg://" scheme (psycopg v3), not plain "postgresql://"
GROQ_API_KEY=            # analyst + exec-summary synthesis (Groq, OpenAI-compatible API)
TAVILY_API_KEY=          # competitor/source auto-discovery web search (tavily.com, free tier, no card)
GCP_PROJECT_ID=          # for Cloud Run/Scheduler
PIPELINE_SHARED_SECRET=  # optional locally (unset = middleware no-ops); required on the public
                          # Cloud Run API service — see backend/main.py's require_shared_secret.
                          # Must match the frontend's own PIPELINE_SHARED_SECRET
                          # (frontend/.env.local.example) exactly.
PIPELINE_TIME_BUDGET_SECONDS=  # optional, default 2700: the scheduled pass stops starting new
                               # companies after this long (keep below the Cloud Run timeout)

# Note: embeddings run locally via sentence-transformers (free, no API key needed)
