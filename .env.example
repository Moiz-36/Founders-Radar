DATABASE_URL=            # Supabase Postgres connection string — use the "postgresql+psycopg://" scheme (psycopg v3), not plain "postgresql://"
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=  # backend-only — uploads rendered PDFs to the private "reports" Storage bucket (backend/report/storage.py), bypassing RLS. Never expose to the frontend.
GROQ_API_KEY=            # analyst + exec-summary synthesis (Groq, OpenAI-compatible API)
TAVILY_API_KEY=          # competitor/source auto-discovery web search (tavily.com, free tier, no card)
REDDIT_CLIENT_ID=        # community-signal collector's Reddit search (reddit.com/prefs/apps, "script" app, free, no card). Optional — collector degrades to HN-only without it.
REDDIT_CLIENT_SECRET=
GCP_PROJECT_ID=          # for Cloud Functions/Scheduler

# Note: embeddings run locally via sentence-transformers (free, no API key needed)
